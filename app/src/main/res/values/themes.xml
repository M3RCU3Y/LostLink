<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LostLink" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/mint</item>
        <item name="colorOnPrimary">@color/ink</item>
        <item name="colorPrimaryContainer">@color/mint_dark</item>
        <item name="colorOnPrimaryContainer">@color/mint</item>
        <item name="colorSecondary">@color/mint</item>
        <item name="colorOnSecondary">@color/ink</item>
        <item name="colorSecondaryContainer">@color/surface_high</item>
        <item name="colorOnSecondaryContainer">@color/text</item>
        <item name="colorError">@color/danger</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <item name="colorSurfaceContainerLowest">@color/bg</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface_high</item>
        <item name="colorSurfaceContainerHighest">@color/surface_high</item>
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="materialCardViewStyle">@style/Card</item>
    </style>

    <style name="Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Title">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text</item>
    </style>
    <style name="Body">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>
    <style name="Section">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">22dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">@color/mint</item>
    </style>
    <style name="Mono">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/mint</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="BigButton" parent="Widget.Material3.Button">
        <item name="android:minHeight">58dp</item>
        <item name="android:textSize">16sp</item>
        <item name="cornerRadius">16dp</item>
    </style>
    <style name="OutlineButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">58dp</item>
        <item name="android:textSize">16sp</item>
        <item name="cornerRadius">16dp</item>
    </style>
    <style name="Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextColor">@color/text</item>
        <item name="subtitleTextColor">@color/muted</item>
        <item name="navigationIconTint">@color/text</item>
    </style>
</resources>
